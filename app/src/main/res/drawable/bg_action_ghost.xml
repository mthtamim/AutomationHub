<?xml version="1.0" encoding="utf-8"?>
<!-- Premium feel: same 14dp ghost pill, now a ripple — the press
     feedback follows the pill shape (the shape is the ripple's
     mask). Used by the rule/flow pills, the editor chips and the
     template buttons. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/colorSurfaceContainer" />
            <stroke android:width="1dp" android:color="?attr/colorOutline" />
            <padding android:left="14dp" android:top="7dp" android:right="14dp" android:bottom="7dp" />
        </shape>
    </item>
</ripple>

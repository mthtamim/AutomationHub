<?xml version="1.0" encoding="utf-8"?>
<!-- Essentials pill bottom bar (v1.2.0): a light sage-green rounded
     bar holding Home / DIY / Settings, selected tab = dark pill
     with light text+icon; a separate dark-green circular + button
     sits at the right end. Included by activity_main (id bottomNav)
     and activity_automation (id autoBottomNav) with the same ids
     and the same tab behaviour as the old BottomNavigationView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/navBarPill"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_bar"
        android:orientation="horizontal"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/navTabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_sel"
            android:foreground="@drawable/bg_nav_tab_ripple"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navIcoHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="@color/ess_bar_sel_text" />

            <TextView
                android:id="@+id/navTxtHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/nav_home"
                android:textColor="@color/ess_bar_sel_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTabAuto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="@drawable/bg_nav_tab_ripple"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navIcoAuto"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_auto"
                app:tint="@color/ess_bar_text" />

            <TextView
                android:id="@+id/navTxtAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/nav_diy"
                android:textColor="@color/ess_bar_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="@drawable/bg_nav_tab_ripple"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navIcoSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/ess_bar_text" />

            <TextView
                android:id="@+id/navTxtSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/nav_settings"
                android:textColor="@color/ess_bar_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/navAdd"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_nav_add"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/auto_add_action"
        android:src="@drawable/ic_plus"
        app:tint="?attr/colorOnPrimary" />
</LinearLayout>

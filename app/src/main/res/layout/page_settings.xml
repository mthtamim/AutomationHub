<?xml version="1.0" encoding="utf-8"?>
<!-- Settings hub (v2.17.2, approved preview): status pill, the hub
     tiles, a panic card, More tiles and diagnostics. The "Connected
     device & account" card (pair-key management) and the MQTT & Email
     tile were removed 2026-11-06 — no pairing / forwarding in
     AutomationHub (see the README). The legacy full menu below the
     hub is REMOVED — every panel it opened is reachable exactly
     once from a tile or card on this page. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- v2.17.3: Settings is a top-level tab — NO back arrow.
             Back navigation lives on the system Back button and on
             true sub-screens only. -->
        <TextView
            style="@style/PL.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings" />

        <TextView
            android:id="@+id/tvSetPill"
            style="@style/PL.Pill"
            android:layout_marginTop="11dp" />

        <TextView
            style="@style/PL.SecTitle"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/set_hub" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileHubPerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="132dp"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_shield_check" />
                    </FrameLayout>

                    <TextView
                        style="@style/PL.TileTitle"
                        android:layout_marginTop="9dp"
                        android:text="@string/set_perms"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHubPermsSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileHubSecurity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="132dp"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_lock" />
                    </FrameLayout>

                    <TextView
                        style="@style/PL.TileTitle"
                        android:layout_marginTop="9dp"
                        android:text="@string/set_security"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHubSecSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            
        </LinearLayout>


        <TextView
            style="@style/PL.SecTitle"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/set_more" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileHubSmart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="104dp"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bulb" />
                    </FrameLayout>

                    <TextView
                        style="@style/PL.TileTitle"
                        android:layout_marginTop="9dp"
                        android:text="@string/cat_smart"
                        android:textSize="14.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileHubData"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="104dp"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_db" />
                    </FrameLayout>

                    <TextView
                        style="@style/PL.TileTitle"
                        android:layout_marginTop="9dp"
                        android:text="@string/set_data"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tvHubDataSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileHubGeneral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="104dp"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sliders" />
                    </FrameLayout>

                    <TextView
                        style="@style/PL.TileTitle"
                        android:layout_marginTop="9dp"
                        android:text="@string/cat_general"
                        android:textSize="14.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            
        </LinearLayout>

        <TextView
            style="@style/PL.SecTitle"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/set_diag" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvHubDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12.5sp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2.6: moved verbatim out of activity_main.xml so the panel
     inflates lazily (ViewStub) on first open instead of at cold
     start. Only the xmlns declarations were added to the root;
     every id, view and attribute inside is unchanged. -->
<LinearLayout
            android:id="@+id/panelSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto">

<!-- ===== Security and App Lock screen (v2.17.2): every security
     control lives here exactly once ===== -->
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_shield" />
                <TextView
                    style="@style/PL.BodySmall"
                    android:text="@string/sec_shield_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_app_lock" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAppLock"
                    style="@style/PL.SwitchRow"
                    android:text="@string/lock_label" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePin"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_change_pin"
                    app:icon="@drawable/ic_lock" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />
                <TextView
                    android:id="@+id/tvPinInfo"
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetPin"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_set_pin"
                    app:icon="@drawable/ic_lock" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swIntruder"
                    style="@style/PL.SwitchRow"
                    android:text="@string/intruder_label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
<!-- v2.18 App Locker: entry card — the locker itself is managed on
     its own screen (AppLockerActivity); this card is the one door. -->
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/alk_title" />
                <TextView
                    style="@style/PL.BodySmall"
                    android:text="@string/alk_sub" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAppLocker"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/alk_open_btn"
                    app:icon="@drawable/ic_lock" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_admin_guard" />
                <!-- v2.17.4: Device Admin and Accessibility are
                     GRANTED only in Permissions & Access now —
                     here just their state lines and one link. -->
                <TextView
                    android:id="@+id/tvAdminInfo"
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="8dp" />
                <TextView
                    android:id="@+id/tvA11yState"
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecPermsLink"
                    style="@style/PL.BtnGhost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_perms_link"
                    app:icon="@drawable/ic_shield_check" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Templates gallery (new 2026-11-06): the window behind the ⋮ menu's
     Templates entry on both Automation tabs. Mirrors the Focus Guard
     picker layout: back chip + title, search box, then a list with
     Rules and Flows sections. Rows are built in code
     (TemplatesActivity) because the Add button state changes per row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnTemplatesBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_back_chip"
            android:contentDescription="@string/btn_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            style="@style/PL.H1"
            android:layout_width="0dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/templates_title" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <EditText
            android:id="@+id/etTemplatesSearch"
            style="@style/PL.SearchBox"
            android:hint="@string/templates_search_hint"
            android:inputType="text"
            app:drawableStartCompat="@drawable/ic_search" />

        <ListView
            android:id="@+id/lvTemplates"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null" />
    </LinearLayout>
</LinearLayout>

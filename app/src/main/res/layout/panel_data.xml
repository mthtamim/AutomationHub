<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2.6: moved verbatim out of activity_main.xml so the panel
     inflates lazily (ViewStub) on first open instead of at cold
     start. Only the xmlns declarations were added to the root;
     every id, view and attribute inside is unchanged. -->
<LinearLayout
            android:id="@+id/panelData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto">

<!-- ===== Data & statistics card ===== -->
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_data" />

                <TextView
                    android:id="@+id/tvStats"
                    style="@style/PL.BodySmall" />

                

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />

                

                

                

                

                
            
                
                

                

                <!-- v2.17.4: history charts moved here from Group -->
                

                
                </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

<!-- ===== Full settings backup (v2.17.4: moved from Group) ===== -->
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_full_backup" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportConfig"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_export_config"
                    app:icon="@drawable/ic_upload" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportConfig"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_import_config"
                    app:icon="@drawable/ic_download" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportPhonelink"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_import_phonelink"
                    app:icon="@drawable/ic_download" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfigCode"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_config_code"
                    app:icon="@drawable/ic_copy" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

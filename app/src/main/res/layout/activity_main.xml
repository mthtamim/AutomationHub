<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- v2.17.3 header: ONE slim row — small wordmark + the live
         connection pill (real latency). The tagline block is gone
         from tab pages. The toolbar id is kept because the
         sub-screen open/close flow toggles its visibility. -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvConnPill"
            style="@style/PL.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageHome"
            layout="@layout/page_home" />

        <!-- AutomationHub: Inbox (forwarded messages), the pairing /
             forwarding config page, and the Remote / Command Hub page
             were removed with the relay — only Home + Settings remain
             in MainActivity; Automation lives in AutomationActivity. -->

        <!-- ===== Settings page (v2.17): a bottom-nav tab now; the
             back chip inside page_settings returns to Dashboard ===== -->
        <!-- v1.2.6: lazy — the Settings hub is NOT inflated at cold
             start; MainActivity.ensureSettings() inflates it on the
             first visit to the Settings tab. -->
        <ViewStub
            android:id="@+id/stubSettings"
            android:inflatedId="@+id/pageSettings"
            android:layout="@layout/page_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ===== Sub-screen overlay (v2.4.1) ===== -->
        <FrameLayout
            android:id="@+id/subRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageButton
                        android:id="@+id/btnSubBack"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_back_chip"
                        android:foreground="?attr/selectableItemBackground"
                        android:contentDescription="@string/btn_back"
                        android:padding="10dp"
                        android:src="@drawable/ic_arrow_back"
                        android:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvSubTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/subScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/subContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <!-- v1.2.6: lazy — inflated by MainActivity.ensurePanel() on first open. -->
                    <ViewStub
                        android:id="@+id/stubPanelGeneral"
                        android:inflatedId="@+id/panelGeneral"
                        android:layout="@layout/panel_general"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />


                    <!-- v1.2.6: lazy — inflated by MainActivity.ensurePanel() on first open. -->
                    <ViewStub
                        android:id="@+id/stubPanelSmart"
                        android:inflatedId="@+id/panelSmart"
                        android:layout="@layout/panel_smart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- v1.2.6: lazy — inflated by MainActivity.ensurePanel() on first open. -->
                    <ViewStub
                        android:id="@+id/stubPanelSecurity"
                        android:inflatedId="@+id/panelSecurity"
                        android:layout="@layout/panel_security"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- v1.2.6: lazy — inflated by MainActivity.ensurePanel() on first open. -->
                    <ViewStub
                        android:id="@+id/stubPanelData"
                        android:inflatedId="@+id/panelData"
                        android:layout="@layout/panel_data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- v1.4.0: M3 NavigationBar + FAB (Home / DIY / Templates /
         Settings + new sheet). Same id and behaviour contract as
         the old pill bar: the bar is hidden while a sub-screen
         is open (openSubScreen / closeSubScreen toggle it). -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/nav_m3_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>

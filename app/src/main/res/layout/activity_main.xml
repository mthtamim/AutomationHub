<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- v2.17.3 header: ONE slim row — small wordmark + the live
         connection pill (real latency). The tagline block is gone
         from tab pages. The toolbar id is kept because the
         sub-screen open/close flow toggles its visibility. -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvConnPill"
            style="@style/PL.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageHome"
            layout="@layout/page_home" />

        <!-- AutomationHub: Inbox (forwarded messages), the pairing /
             forwarding config page, and the Remote / Command Hub page
             were removed with the relay — only Home + Settings remain
             in MainActivity; Automation lives in AutomationActivity. -->

        <!-- ===== Settings page (v2.17): a bottom-nav tab now; the
             back chip inside page_settings returns to Dashboard ===== -->
        <include
            android:id="@+id/pageSettings"
            layout="@layout/page_settings"
            android:visibility="gone" />

        <!-- ===== Sub-screen overlay (v2.4.1) ===== -->
        <FrameLayout
            android:id="@+id/subRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageButton
                        android:id="@+id/btnSubBack"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_back_chip"
                        android:contentDescription="@string/btn_back"
                        android:padding="10dp"
                        android:src="@drawable/ic_arrow_back"
                        android:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvSubTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/subScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/subContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <LinearLayout
            android:id="@+id/panelGeneral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

<!-- ===== Appearance card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_appearance" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_language"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleLang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangBn"
                        style="@style/PL.BtnToggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lang_bn" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangEn"
                        style="@style/PL.BtnToggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lang_en" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_theme"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeSystem"
                        style="@style/PL.BtnToggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_system" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeLight"
                        style="@style/PL.BtnToggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_light" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeDark"
                        style="@style/PL.BtnToggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_dark" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccent"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_accent"
                    app:icon="@drawable/ic_sliders" />

                <!-- v2.25.0: optional app theme picker (8 themes). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAppTheme"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_app_theme"
                    app:icon="@drawable/ic_sliders" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckUpdate"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_update"
                    app:icon="@drawable/ic_refresh" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoUpdate"
                    style="@style/PL.SwitchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/sw_auto_update" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

<TextView
            style="@style/PL.BodySmall"
            android:layout_marginTop="4dp"
            android:text="@string/footer_about" />

<TextView
            android:id="@+id/tvGeneralDiag"
            style="@style/PL.BodySmall"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />
</LinearLayout>


<LinearLayout
            android:id="@+id/panelSmart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

<!-- ===== Smart control card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_smart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApps"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_apps"
                    app:icon="@drawable/ic_grid" />

                <TextView
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="6dp"
                    android:text="@string/apps_hint_short" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swQuiet"
                    style="@style/PL.SwitchRow"
                    android:text="@string/quiet_label" />

                <TextView
                    android:id="@+id/tvQuietInfo"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuietTimes"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_quiet_times"
                    app:icon="@drawable/ic_clock" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/digest_label"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvDigestInfo"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDigest"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_digest"
                    app:icon="@drawable/ic_msg" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PL.Field"
                    android:hint="@string/hint_priority">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPriority"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="2"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PL.Field"
                    android:hint="@string/hint_alert_words">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAlertWords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="2"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSmart"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_save"
                    app:icon="@drawable/ic_check" />

                <TextView
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="8dp"
                    android:text="@string/priority_hint" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSmsTrigger"
                    style="@style/PL.SwitchRow"
                    android:text="@string/sms_trigger_label" />

                <TextView
                    style="@style/PL.BodySmall"
                    android:text="@string/sms_trigger_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
<!-- ===== More features card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_more" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swTts"
                    style="@style/PL.SwitchRow"
                    android:text="@string/tts_label" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swTtsCalls"
                    style="@style/PL.SwitchRow"
                    android:text="@string/tts_calls_label" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSmsReply"
                    style="@style/PL.SwitchRow"
                    android:text="@string/sms_reply_label" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoReply"
                    style="@style/PL.SwitchRow"
                    android:text="@string/auto_reply_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PL.Field"
                    android:hint="@string/hint_auto_reply">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAutoReply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="2"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swRoutine"
                    style="@style/PL.SwitchRow"
                    android:text="@string/routine_label" />

                <TextView
                    android:id="@+id/tvRoutineInfo"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoutineTime"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_routine_time"
                    app:icon="@drawable/ic_clock" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swLowLoc"
                    style="@style/PL.SwitchRow"
                    android:text="@string/low_loc_label" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swGeo"
                    style="@style/PL.SwitchRow"
                    android:text="@string/geo_label" />

                <TextView
                    android:id="@+id/tvGeoInfo"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetGeo"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_set_geo"
                    app:icon="@drawable/ic_loc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGeoRadius"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_geo_radius"
                    app:icon="@drawable/ic_loc" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swDailySummary"
                    style="@style/PL.SwitchRow"
                    android:text="@string/daily_summary_label" />

                <!-- v2.17.4: Usage Access is GRANTED only in
                     Permissions & Access now — here just its state
                     and a link (no second grant button). -->
                <TextView
                    android:id="@+id/tvSmartUsageState"
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSmartPermsLink"
                    style="@style/PL.BtnGhost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/btn_perms_link"
                    app:icon="@drawable/ic_shield_check" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_smart_extra" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoPriority"
                    style="@style/PL.SwitchRow"
                    android:text="@string/auto_priority_label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

<!-- ===== Automation card (v2.17.4): engine master switch, the
     focus guard and the mode bundle (both moved from the Command
     Hub — they are settings, not commands), and the Studio link
     row (sync state + rest value live in the Studio itself) ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_automation" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoMaster"
                    style="@style/PL.SwitchRow"
                    android:text="@string/auto_master_label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFocusGuard"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/cmd_focus"
                    app:icon="@drawable/ic_shield_check" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMode"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_mode"
                    app:icon="@drawable/ic_sliders" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    android:id="@+id/tvSmartStudioInfo"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSmartStudio"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_open_studio"
                    app:icon="@drawable/ic_bulb" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

<LinearLayout
            android:id="@+id/panelSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

<!-- ===== Security and App Lock screen (v2.17.2): every security
     control lives here exactly once ===== -->
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_shield" />
                <TextView
                    style="@style/PL.BodySmall"
                    android:text="@string/sec_shield_sub" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swEncryption"
                    style="@style/PL.SwitchRow"
                    android:text="@string/enc_label" />
                <TextView
                    style="@style/PL.BodySmall"
                    android:text="@string/enc_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_app_lock" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAppLock"
                    style="@style/PL.SwitchRow"
                    android:text="@string/lock_label" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePin"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_change_pin"
                    app:icon="@drawable/ic_lock" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />
                <TextView
                    android:id="@+id/tvPinInfo"
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetPin"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_set_pin"
                    app:icon="@drawable/ic_lock" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
<!-- v2.18 App Locker: entry card — the locker itself is managed on
     its own screen (AppLockerActivity); this card is the one door. -->
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/alk_title" />
                <TextView
                    style="@style/PL.BodySmall"
                    android:text="@string/alk_sub" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAppLocker"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/alk_open_btn"
                    app:icon="@drawable/ic_lock" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/set_panic_title" />
                <TextView
                    style="@style/PL.BodySmall"
                    android:text="@string/set_panic_sub" />
                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPanicPin"
                                    style="@style/PL.BtnMint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/btn_panic_pin"
                                    app:icon="@drawable/ic_alert" />

                <!-- v2.17.4: SOS numbers moved here from General —
                     panic PIN and SOS numbers are one emergency
                     section now (the SOS button stays on Dashboard) -->
                <TextView
                    style="@style/PL.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_sos_numbers" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSosNumbers"
                    style="@style/PL.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_sos_numbers"
                    android:inputType="phone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSos"
                    style="@style/PL.BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_save"
                    app:icon="@drawable/ic_check" />
                <!-- AutomationHub: the launcher-hide switch is gone
                     with the .MainAlias alias (no relay, no SHOWAPP). -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swIntruder"
                    style="@style/PL.SwitchRow"
                    android:text="@string/intruder_label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_admin_guard" />
                <!-- v2.17.4: Device Admin and Accessibility are
                     GRANTED only in Permissions & Access now —
                     here just their state lines and one link. -->
                <TextView
                    android:id="@+id/tvAdminInfo"
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="8dp" />
                <TextView
                    android:id="@+id/tvA11yState"
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecPermsLink"
                    style="@style/PL.BtnGhost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_perms_link"
                    app:icon="@drawable/ic_shield_check" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swGuard"
                    style="@style/PL.SwitchRow"
                    android:text="@string/guard_label" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecLog"
                    style="@style/PL.BtnPill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_seclog"
                    app:icon="@drawable/ic_file" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>


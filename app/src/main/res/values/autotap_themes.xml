<?xml version="1.0" encoding="utf-8"?>
<!-- AutoTap screens keep their own theme; its values already match
     PhoneLink's dark tokens (bg #101415, accent #10B981). -->
<resources>
    <!-- v1.3.0: M3 parent, so MaterialAlertDialogBuilder and the
         M3 pickers resolve real M3 tokens on the AutoTap screens.
         Same colours as before (bg #101415, accent #10B981). -->
    <style name="Theme.AutoTap" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#10B981</item>
        <item name="colorPrimaryDark">#101415</item>
        <item name="colorAccent">#2FD68F</item>
        <item name="android:windowBackground">#101415</item>
        <item name="android:statusBarColor">#101415</item>
        <item name="android:navigationBarColor">#101415</item>
    </style>
</resources>
